          "path": "core.clj",
          "expected_file": "expected/clojure-qualified-symbol-rename/core.clj",
          "weight": 4
        },
        {
          "id": "balanced",
          "type": "lisp_balance",
          "path": "core.clj",
          "weight": 1
        },
        {
          "id": "alias-preserved",
          "type": "text_contains",
          "path": "core.clj",
          "text": "calc/sum",
          "weight": 1
        },
        {
          "id": "protected",
          "type": "file_unchanged",
          "path": "DO_NOT_TOUCH.txt",
          "weight": 1
        }
      ]
    },
    {
