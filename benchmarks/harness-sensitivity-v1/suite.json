    {
      "id": "org-structured-authoring",
      "title": "Author a structured Org section",
      "domain": "org",
      "category": "authoring",
      "difficulty": "medium",
      "prompt_file": "prompts/org-structured-authoring.md",
      "fixture_dir": "fixtures/org-structured-authoring",
      "allowed_paths": [
        "notes.org"
      ],
      "protected_paths": [
        "DO_NOT_TOUCH.txt"
      ],
      "checks": [
        {
          "id": "exact",
          "type": "exact_text",
          "path": "notes.org",
          "expected_file": "expected/org-structured-authoring/notes.org",
          "weight": 4
        },
        {
          "id": "structure",
          "type": "org_structure",
          "path": "notes.org",
          "expect": {
            "exact_headings": 3,
            "required_titles": [
              "Project",
              "Data",
              "Computation"
            ],
            "exact_tables": 1,
            "exact_src_blocks": 1,
            "required_languages": [
              "emacs-lisp"
            ],
            "required_properties": {
              "OWNER": "Kevin"
            }
          },
          "weight": 3
        },
        {
          "id": "intro-preserved",
          "type": "text_contains",
          "path": "notes.org",
          "text": "Existing introduction. Keep this line.",
          "weight": 1
        },
        {
          "id": "protected",
          "type": "file_unchanged",
          "path": "DO_NOT_TOUCH.txt",
          "weight": 1
        }
      ]
    }
  ]
