{
  "schema_version": "1.0",
  "id": "harness-sensitivity-v1",
  "revision": "2026-08-31.1",
  "title": "Emacs Operator benchmark harness sensitivity v1",
  "description": "Portable deterministic tasks used only to verify that the benchmark harness detects semantic correctness, collateral text edits, syntax damage, Org structure damage, protected-file edits, and unauthorized-path edits. Reference-versus-naive results are not evidence of LLM superiority.",
  "defaults": {
    "timeout_ms": 15000,
    "trials": 1,
    "pass_threshold": 1,
    "max_workspace_bytes": 16777216,
    "max_agent_output_bytes": 2097152
  },
  "tasks": [
    {
      "id": "elisp-symbol-boundary-rename",
      "title": "Rename an exact Emacs Lisp symbol",
      "domain": "elisp",
      "category": "refactor",
      "difficulty": "small",
      "prompt_file": "prompts/elisp-symbol-boundary-rename.md",
      "fixture_dir": "fixtures/elisp-symbol-boundary-rename",
      "allowed_paths": [
        "main.el"
      ],
      "protected_paths": [
        "DO_NOT_TOUCH.txt"
      ],
      "checks": [
        {
          "id": "exact",
          "type": "exact_text",
          "path": "main.el",
          "expected_file": "expected/elisp-symbol-boundary-rename/main.el",
          "weight": 4
        },
        {
          "id": "balanced",
          "type": "lisp_balance",
          "path": "main.el",
          "weight": 1
        },
        {
          "id": "protected",
          "type": "file_unchanged",
          "path": "DO_NOT_TOUCH.txt",
          "weight": 1
        }
      ]
    },
    {
      "id": "clojure-qualified-symbol-rename",
      "title": "Rename a qualified Clojure symbol leaf",
      "domain": "clojure",
      "category": "refactor",
      "difficulty": "medium",
