      "id": "elisp-repair-safe-divide",
      "title": "Repair zero-safe division",
      "domain": "elisp",
      "category": "repair",
      "difficulty": "small",
      "prompt_file": "prompts/elisp-repair-safe-divide.md",
      "fixture_dir": "fixtures/elisp-repair-safe-divide",
      "tags": ["evaluation", "repair", "condition"],
      "requirements": {"executables": ["emacs"]},
      "allowed_paths": ["safe-math.el"],
      "protected_paths": ["DO_NOT_TOUCH.txt"],
      "checks": [
        {"id":"balanced","type":"lisp_balance","path":"safe-math.el","weight":1},
        {"id":"api","type":"text_contains","path":"safe-math.el","text":"(defun safe-divide ","weight":1},
        {"id":"runtime","type":"command","command":["emacs","--batch","-Q","-L",".","-l","safe-math.el","-l","${suite}/verifiers/elisp-repair-safe-divide.el"],"stdout_contains":"BENCHMARK_PASS elisp-repair-safe-divide","timeout_ms":30000,"weight":5},
        {"id":"protected","type":"file_unchanged","path":"DO_NOT_TOUCH.txt","weight":1}
      ]
    },
