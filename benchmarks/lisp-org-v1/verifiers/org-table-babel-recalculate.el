;;; org-table-babel-recalculate.el --- Benchmark verifier -*- lexical-binding: t; -*-
(require 'org)
(require 'ob-emacs-lisp)
(find-file "calculation.org")
(org-mode)
(goto-char (point-min))
(unless (search-forward "#+name: values" nil t) (error "named table values is missing"))
(forward-line 1)
(unless (equal (org-table-to-lisp) '((40) (2))) (error "the named table values is not ((40) (2))"))
(goto-char (point-min))
(unless (re-search-forward "^#\\+begin_src emacs-lisp" nil t) (error "source block is missing"))
(goto-char (match-beginning 0))
(let ((org-confirm-babel-evaluate nil))
  (unless (equal (org-babel-execute-src-block) 42) (error "Babel block did not evaluate to 42")))
(goto-char (point-min))
(unless (= (how-many "^#\\+RESULTS:" (point-min) (point-max)) 1) (error "expected exactly one results block"))
(unless (re-search-forward "^#\\+RESULTS:.*\\n:[[:space:]]*42[[:space:]]*$" nil t) (error "result 42 is missing"))
(unless (search-forward "Preserve this note exactly." nil t) (error "final note was changed"))
(unless (search-forward "The note below must remain unchanged." nil t) (error "explanatory line was changed"))
(princ "BENCHMARK_PASS org-table-babel-recalculate\n")
