;;; org-rewrite-subtree.el --- Benchmark verifier -*- lexical-binding: t; -*-
(require 'org)
(find-file "notes.org")
(org-mode)
(goto-char (point-min))
(unless (re-search-forward "^\\* Delivery Plan" nil t) (error "renamed heading is missing"))
(org-back-to-heading t)
(unless (equal (sort (org-get-tags nil t) #'string<) '("agent" "alpha11"))
  (error "Delivery Plan tags are not alpha11 and agent"))
(unless (equal (org-entry-get nil "OWNER") "Kevin") (error "OWNER property is not Kevin"))
(let* ((subtree-start (point))
       (subtree-end (save-excursion (org-end-of-subtree t t)))
       (text (buffer-substring-no-properties subtree-start subtree-end)))
  (unless (string-match-p (regexp-quote "Updated body for the delivery plan.") text) (error "new body is missing"))
  (when (string-match-p (regexp-quote "Old body that must be replaced.") text) (error "old body remains"))
  (unless (string-match-p "^\\*\\* Child[[:space:]]*$" text) (error "Child heading was removed"))
  (unless (string-match-p (regexp-quote "Keep this child text exactly.") text) (error "Child text was changed")))
(goto-char (point-min))
(unless (search-forward "* Unrelated\nKeep this unrelated subtree exactly." nil t) (error "Unrelated subtree was changed"))
(goto-char (point-min))
(unless (search-forward "#+title: Rewrite Fixture" nil t) (error "document title was removed"))
(princ "BENCHMARK_PASS org-rewrite-subtree\n")
