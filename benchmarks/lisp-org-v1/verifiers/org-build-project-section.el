;;; org-build-project-section.el --- Benchmark verifier -*- lexical-binding: t; -*-
(require 'org)
(require 'ob-emacs-lisp)
(find-file "notes.org")
(org-mode)
(goto-char (point-min))
(unless (search-forward "#+title: Benchmark Notes" nil t) (error "document title was removed"))
(goto-char (point-min))
(unless (search-forward "Existing introduction. Keep this line." nil t) (error "existing introduction was removed"))
(goto-char (point-min))
(unless (re-search-forward "^\\* Project Alpha[[:space:]]*$" nil t) (error "Project Alpha heading is missing"))
(org-back-to-heading t)
(unless (equal (org-entry-get nil "OWNER") "Kevin") (error "Project Alpha OWNER property is not Kevin"))
(unless (re-search-forward "^\\*\\* Metrics[[:space:]]*$" nil t) (error "Metrics child heading is missing"))
(unless (re-search-forward "|[[:space:]]*Answer[[:space:]]*|[[:space:]]*42[[:space:]]*|" nil t) (error "Answer table row is missing"))
(unless (re-search-forward "^\\*\\* Computation[[:space:]]*$" nil t) (error "Computation child heading is missing"))
(unless (re-search-forward "^#\\+begin_src emacs-lisp" nil t) (error "emacs-lisp source block is missing"))
(goto-char (match-beginning 0))
(let ((org-confirm-babel-evaluate nil))
  (unless (equal (org-babel-execute-src-block) 42) (error "Babel block did not evaluate to 42")))
(goto-char (point-min))
(unless (re-search-forward "^#\\+RESULTS:.*\\n:[[:space:]]*42[[:space:]]*$" nil t) (error "Babel result 42 is missing"))
(princ "BENCHMARK_PASS org-build-project-section\n")
