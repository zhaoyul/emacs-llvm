{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REPL verification rerun policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "default": 3
    },
    "side_effect_risk": {
      "enum": [
        "low",
        "high",
        "unknown"
      ],
      "default": "unknown"
    },
    "allow_risky_rerun": {
      "type": "boolean",
      "default": false
    }
  }
}
