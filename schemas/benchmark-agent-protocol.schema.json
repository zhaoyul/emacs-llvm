{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redcreation.cn/schemas/emacs-operator/benchmark-agent-protocol-1.0.json",
  "title": "Emacs Operator benchmark agent protocol",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/result"}
  ],
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": true,
      "required": ["at_ms", "kind"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "at_ms": {"type": "number", "minimum": 0},
        "kind": {"enum": ["agent_started", "agent_finished", "tool_call", "tool_result", "validation", "evaluation", "rollback", "note"]},
        "tool": {"type": "string", "maxLength": 256},
        "operation": {"type": "string", "maxLength": 256},
        "channel": {"enum": ["semantic", "internal_keys", "native_keys", "filesystem", "other"]},
        "mutation": {"type": "boolean"},
        "ok": {"type": "boolean"},
        "duration_ms": {"type": "number", "minimum": 0},
        "error_code": {"type": "string", "maxLength": 128},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "mutations": {"type": "integer", "minimum": 0},
        "rollbacks": {"type": "integer", "minimum": 0}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "run_id", "suite_id", "suite_revision", "suite_digest", "task_id", "task_digest", "trial", "trial_seed", "prompt", "workspace", "timeout_ms", "trace_path", "metadata"],
      "properties": {
        "protocol_version": {"const": "1.0"},
        "run_id": {"type": "string"},
        "suite_id": {"type": "string"},
        "suite_revision": {"type": "string"},
        "suite_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "task_id": {"type": "string"},
        "task_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "trial": {"type": "integer", "minimum": 1},
        "trial_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "prompt": {"type": "string"},
        "workspace": {"type": "string"},
        "timeout_ms": {"type": "integer", "minimum": 1},
        "trace_path": {"type": "string"},
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "category", "difficulty", "tags"],
          "properties": {
            "domain": {"enum": ["elisp", "clojure", "common_lisp", "org", "mixed"]},
            "category": {"enum": ["repair", "refactor", "authoring", "navigation", "evaluation"]},
            "difficulty": {"enum": ["small", "medium", "large"]},
            "tags": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "status"],
      "properties": {
        "protocol_version": {"const": "1.0"},
        "status": {"enum": ["completed", "failed", "refused", "timeout", "protocol_error"]},
        "summary": {"type": "string", "maxLength": 8192},
        "usage": {"$ref": "#/$defs/usage"},
        "events": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/event"}}
      }
    }
  }
}
