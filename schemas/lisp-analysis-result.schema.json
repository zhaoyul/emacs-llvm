{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conservative Lisp extract parameter analysis",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "parameters",
    "unresolved",
    "confidence",
    "source_sha256"
  ],
  "properties": {
    "parameters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bounds": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "diagnostics": {
      "type": "array"
    }
  }
}
